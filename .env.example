# QuickChat web app environment (copy to `.env` and edit)
#
# CRA inlines these values at build time, so restart the dev server or rebuild
# after changing them.
#
# --- Local development ------------------------------------------------------
REACT_APP_ENV=local
# Empty means same-origin `/api`; `npm run dev` proxies it to the local API.
REACT_APP_API_URL=
REACT_APP_SITE_URL=http://localhost:5001
REACT_APP_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# --- Live domain ------------------------------------------------------------
# Set these when deploying to your main domain. Express serves the React build
# and the API from the same origin, so an empty API URL keeps every request
# on your domain (no CORS, no extra subdomain).
# REACT_APP_ENV=live
# REACT_APP_API_URL=
# REACT_APP_SITE_URL=https://nodexplatform.com.ng
#
# If the API lives on a different origin, set the full API base instead:
# REACT_APP_API_URL=https://api.nodexplatform.com.ng/api
# and add the site origin to CLIENT_ORIGIN in server/.env.

# VAPID public key is read from /api/config at runtime. Only set this to
# override the server key.
# REACT_APP_VAPID_PUBLIC_KEY=
