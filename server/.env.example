# ============================================================================
#  QUICKCHAT DEPLOYMENT ENVIRONMENT CONFIGURATION EXAMPLE
#  Copy this file to server/.env and customize as needed.
#
#  * TO RUN LOCALLY: Keep OPTION A active (uncommented).
#  * TO RUN ON LIVE SERVER (e.g. nodexplatform.com.ng):
#      1. Comment out OPTION A
#      2. Uncomment OPTION B
#      3. Restart the server: npm start
# ============================================================================

# ----------------------------------------------------------------------------
# [OPTION A: LOCAL DEVELOPMENT]
# ----------------------------------------------------------------------------
APP_ENV=local
PORT=5000
CLIENT_ORIGIN=http://localhost:5001,http://127.0.0.1:5001,http://localhost:3000
PUBLIC_APP_URL=http://localhost:5001
PUBLIC_API_ORIGIN=http://localhost:5000
FLW_WEBHOOK_URL=http://localhost:5000/api/webhooks/flutterwave
DB_TYPE=sqlite
SQLITE_PATH=./database.sqlite

# ----------------------------------------------------------------------------
# [OPTION B: LIVE PRODUCTION SERVER (nodexplatform.com.ng)]
# (Uncomment when deploying to your live server)
# ----------------------------------------------------------------------------
# APP_ENV=production
# PORT=5000
# CLIENT_ORIGIN=https://nodexplatform.com.ng,https://www.nodexplatform.com.ng
# PUBLIC_APP_URL=https://nodexplatform.com.ng
# PUBLIC_API_ORIGIN=https://nodexplatform.com.ng
# FLW_WEBHOOK_URL=https://nodexplatform.com.ng/api/webhooks/flutterwave
# DB_TYPE=sqlite
# SQLITE_PATH=./database.sqlite
# (Or PostgreSQL on live server:)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/quickchat
# PG_SSL=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Optional: exact email of an existing QuickChat user to bootstrap as the first Super Administrator.
# Create the account first, then set this value and restart the API. Never use a public/shared email.
SUPER_ADMIN_EMAIL=
JWT_SECRET=super_secret_key_123_change_in_production

# ---------------------------------------------------------------------------
# Google sign-in (public client ID, safe to expose)
# ---------------------------------------------------------------------------
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Live streaming and gifts
# ---------------------------------------------------------------------------
LIVE_WELCOME_POINTS=100
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
# Optional TURN relay for mobile networks and restrictive NAT/firewalls
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Browser push notifications
# ---------------------------------------------------------------------------
VAPID_SUBJECT=mailto:hello@nodexplatform.com.ng

# ---------------------------------------------------------------------------
# Flutterwave payments (creator payouts, paid posts, points top-ups)
# ---------------------------------------------------------------------------
FLW_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key
FLW_SECRET_HASH=your-flutterwave-secret-hash

# ---------------------------------------------------------------------------
# NovaAI local model & Smart Engine
# ---------------------------------------------------------------------------
NOVA_AI_OLLAMA_URL=http://localhost:11434/api/chat

# ---------------------------------------------------------------------------
# RSS publisher discovery and personalized news feed
# Add comma-separated QuickChat user IDs permitted to manage RSS publishers.
# Run the RSS worker separately with: npm run rss-worker:start
# ---------------------------------------------------------------------------
RSS_ADMIN_USER_IDS=
RSS_SYNC_CRON=*/15 * * * *
RSS_SYNC_ON_START=true
RSS_REQUEST_TIMEOUT_MS=12000
RSS_MAX_FEED_BYTES=2097152
RSS_MAX_ITEMS_PER_SYNC=60

# ---------------------------------------------------------------------------
# Admin platform backups
# Archives are written outside the public web directory. Confirm storage
# capacity before enabling scheduled snapshots on a production instance.
# BACKUP_DIRECTORY=../private-backups
BACKUP_SCHEDULE_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
