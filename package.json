{
  "name": "quickchat",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "npm run build && npm --prefix server start",
    "dev": "node server/dev.js",
    "dev:frontend": "set \"HOST=127.0.0.1\" && set \"DANGEROUSLY_DISABLE_HOST_CHECK=true\" && set \"PORT=5001\" && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "nodex-admin:start": "set PORT=3102&& npm start"
  },
  "proxy": "http://127.0.0.1:5000",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19"
  },
  "nodexAdmin": {
    "port": 3102,
    "healthPath": "/api/health",
    "startScript": "nodex-admin:start"
  }
}
